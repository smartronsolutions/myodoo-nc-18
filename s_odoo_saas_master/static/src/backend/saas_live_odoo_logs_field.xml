<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="s_odoo_saas_master.SaasLiveOdooLogs">
        <div class="o_saas_live_logs">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span t-if="state.live" class="badge text-bg-success">LIVE</span>
                <span t-else="" class="badge text-bg-secondary">PAUSED</span>
                <span class="text-muted">tail -f mode · starts with latest 50 lines · refreshes every 1.5s</span>
                <span t-if="state.updatedAt" class="text-muted ms-auto" t-esc="state.updatedAt"/>
                <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="onRefreshClick"
                    t-att-disabled="state.refreshing">
                    <i class="fa fa-refresh" t-att-class="{ 'fa-spin': state.refreshing }"/> Refresh
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary" t-on-click="onToggleLive">
                    <t t-if="state.live">Pause</t>
                    <t t-else="">Resume Live</t>
                </button>
            </div>
            <pre t-ref="logOutput" class="o_saas_live_logs_output" t-att-class="{ 'border-danger': state.error }"><t t-esc="state.logs"/></pre>
        </div>
    </t>
</templates>
