<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="saas_odoo_instance_terminal_wizard_form" model="ir.ui.view">
        <field name="name">saas.odoo.instance.terminal.wizard.form</field>
        <field name="model">saas.odoo.instance.terminal.wizard</field>
        <field name="arch" type="xml">
            <form string="Container Terminal" create="0" edit="0">
                <group>
                    <field name="instance_id" readonly="1"/>
                    <field name="terminal_type" readonly="1"/>
                    <field name="current_database" string="Instance Database" readonly="1" invisible="terminal_type != 'psql'"/>
                </group>
                <field name="command" invisible="1"/>
                <field name="exit_code" invisible="1"/>
                <field name="shell_mode" invisible="1"/>
                <field name="output" widget="saas_container_terminal" nolabel="1" class="w-100 d-block"/>
                <footer>
                    <button string="Close" special="cancel" class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="saas_odoo_instance_terminal_wizard_action" model="ir.actions.act_window">
        <field name="name">Container Terminal</field>
        <field name="res_model">saas.odoo.instance.terminal.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="saas_odoo_instance_terminal_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="saas_odoo_instance_python_package_wizard_form" model="ir.ui.view">
        <field name="name">saas.odoo.instance.python.package.wizard.form</field>
        <field name="model">saas.odoo.instance.python.package.wizard</field>
        <field name="arch" type="xml">
            <form string="Install Python Packages">
                <group>
                    <field name="instance_id"/>
                    <field name="package_names" placeholder="requests&#10;psycopg2-binary==2.9.10"/>
                    <field name="output" widget="text" nolabel="1" class="font-monospace" invisible="not output"/>
                    <field name="exit_code" invisible="not output"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    Packages are installed in the live Odoo container. Recreating that container from its image may remove them.
                </div>
                <footer>
                    <button name="action_install" string="Install Packages" type="object" class="oe_highlight"/>
                    <button string="Close" special="cancel" class="oe_link"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="saas_odoo_instance_python_package_wizard_action" model="ir.actions.act_window">
        <field name="name">Install Python Packages</field>
        <field name="res_model">saas.odoo.instance.python.package.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="saas_odoo_instance_python_package_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="saas_odoo_instance_odoo_log_wizard_form" model="ir.ui.view">
        <field name="name">saas.odoo.instance.odoo.log.wizard.form</field>
        <field name="model">saas.odoo.instance.odoo.log.wizard</field>
        <field name="arch" type="xml">
            <form string="Live Odoo Logs" create="0" edit="0">
                <group>
                    <field name="instance_id"/>
                </group>
                <field name="log_output" widget="saas_live_odoo_logs" nolabel="1"/>
                <footer>
                    <button string="Close" special="cancel" class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="saas_odoo_instance_odoo_log_wizard_action" model="ir.actions.act_window">
        <field name="name">Live Odoo Logs</field>
        <field name="res_model">saas.odoo.instance.odoo.log.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="saas_odoo_instance_odoo_log_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
