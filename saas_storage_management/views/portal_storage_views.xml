<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Shared Request-Upgrade modal + toast container + JS, included on any storage page.
         Buttons that open it just need: data-bs-toggle="modal" data-bs-target="#storageUpgradeModal"
         data-instance-id, data-instance-name, data-current-limit. -->
    <template id="storage_upgrade_widget" name="Storage Upgrade Widget">
        <div class="modal fade" id="storageUpgradeModal" tabindex="-1" aria-labelledby="storageUpgradeModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="storageUpgradeModalLabel">Request Storage Upgrade</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-1">Instance: <strong id="storageUpgradeInstanceName">-</strong></p>
                        <p class="text-muted">Current limit: <span id="storageUpgradeCurrentLimit">-</span> GB</p>
                        <div class="mb-3">
                            <label for="storageUpgradeNewLimit" class="form-label">New storage limit (GB)</label>
                            <input type="number" step="0.1" min="0.1" class="form-control" id="storageUpgradeNewLimit" required="required"/>
                        </div>
                        <div id="storageUpgradeError" class="alert alert-danger d-none" role="alert"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary" id="storageUpgradeSubmitBtn">Submit Request</button>
                    </div>
                </div>
            </div>
        </div>

        <div id="messageContainer" style="position: fixed; bottom: 20px; right: 20px; z-index: 9999; max-width: 400px;"></div>

        <script><![CDATA[
            (function(){
                function showMessage(type, message) {
                    var container = document.getElementById('messageContainer');
                    var bgColor = 'bg-info', title = 'Info';
                    if (type === 'success') { bgColor = 'bg-success'; title = '✅ Success'; }
                    else if (type === 'error') { bgColor = 'bg-danger'; title = '❌ Error'; }
                    else if (type === 'warning') { bgColor = 'bg-warning'; title = '⚠️ Warning'; }

                    var alertEl = document.createElement('div');
                    alertEl.className = 'alert ' + bgColor + ' alert-dismissible fade show';
                    alertEl.setAttribute('role', 'alert');
                    alertEl.innerHTML = '<strong>' + title + '</strong><br/>' + message +
                        '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>';
                    container.appendChild(alertEl);
                    setTimeout(function(){ alertEl.remove(); }, 5000);
                }

                var modalEl = document.getElementById('storageUpgradeModal');
                if (!modalEl) { return; }

                var nameEl = document.getElementById('storageUpgradeInstanceName');
                var limitEl = document.getElementById('storageUpgradeCurrentLimit');
                var inputEl = document.getElementById('storageUpgradeNewLimit');
                var errorEl = document.getElementById('storageUpgradeError');
                var submitBtn = document.getElementById('storageUpgradeSubmitBtn');
                var currentInstanceId = null;

                function setError(message) {
                    if (!message) { errorEl.classList.add('d-none'); errorEl.textContent = ''; return; }
                    errorEl.textContent = message;
                    errorEl.classList.remove('d-none');
                }

                modalEl.addEventListener('show.bs.modal', function(ev){
                    var btn = ev.relatedTarget;
                    if (!btn) { return; }
                    currentInstanceId = btn.getAttribute('data-instance-id');
                    nameEl.textContent = btn.getAttribute('data-instance-name') || '';
                    limitEl.textContent = btn.getAttribute('data-current-limit') || '';
                    inputEl.value = '';
                    setError(null);
                });

                submitBtn.addEventListener('click', function(){
                    var newLimit = parseFloat(inputEl.value);

                    if (!currentInstanceId) {
                        setError('Instance not found, please close and try again.');
                        return;
                    }
                    if (isNaN(newLimit) || newLimit <= 0) {
                        setError('Please enter a valid number greater than 0');
                        return;
                    }
                    setError(null);

                    submitBtn.disabled = true;
                    var originalText = submitBtn.innerHTML;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Sending...';

                    fetch('/my/storage/request-upgrade', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({
                            instance_id: parseInt(currentInstanceId),
                            new_limit_gb: newLimit
                        })
                    })
                    .then(function(r){ return r.json(); })
                    .then(function(data){
                        var result = data.result || data;
                        if (result && result.status === 'success') {
                            var modal = window.bootstrap.Modal.getInstance(modalEl);
                            if (modal) { modal.hide(); }
                            showMessage('success', result.message);
                            setTimeout(function(){ location.reload(); }, 1500);
                        } else {
                            setError((result &amp;&amp; result.message) || 'Unknown error, please try again.');
                        }
                    })
                    .catch(function(){
                        setError('An error occurred. Please try again.');
                    })
                    .finally(function(){
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalText;
                    });
                });
            })();
        ]]></script>
    </template>

    <template id="portal_storage_dashboard" name="Storage Dashboard">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h1>Storage Management</h1>

                <!-- Storage Warning Alerts -->
                <t t-foreach="warnings" t-as="warning">
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <strong>⚠️ Storage Warning!</strong>
                        <br/>
                        <span t-esc="warning['instance_name']"/> instance:
                        <br/>
                        You have used <strong><t t-esc="warning['used']"/> GB out of <t t-esc="warning['limit']"/> GB</strong> (<strong><t t-esc="warning['percentage']"/>%</strong>)
                        <t t-if="warning['status'] == 'critical'">
                            <br/>
                            <span class="text-danger"><strong>⛔ CRITICAL: Your storage is almost full!</strong></span>
                        </t>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </t>

                <div t-if="not instances" class="alert alert-info">
                    <p>No instances found.</p>
                </div>

                <t t-foreach="instances" t-as="instance">
                    <div class="card mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><t t-esc="instance.name"/></h5>
                            <a t-attf-href="/my/storage/{{ instance.id }}" class="btn btn-sm btn-outline-secondary">
                                <i class="fa fa-history"/> View Details &amp; History
                            </a>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <t t-if="instance.storage_is_unlimited">
                                        <p><strong>Storage:</strong> <span class="badge bg-info">Unlimited</span></p>
                                        <p><strong>Used:</strong> <t t-esc="round(instance.storage_used_gb, 2)"/> GB</p>
                                    </t>
                                    <t t-else="">
                                        <p><strong>Used:</strong> <t t-esc="round(instance.storage_used_gb, 2)"/> GB / <t t-esc="instance.storage_limit_gb"/> GB</p>
                                        <p><strong>Usage:</strong> <t t-esc="round(instance.storage_percentage, 1)"/>%</p>
                                    </t>
                                </div>
                                <div class="col-md-6">
                                    <t t-if="not instance.storage_is_unlimited">
                                        <div class="progress" style="height: 25px;">
                                            <t t-set="bar_color" t-value="'bg-success' if instance.storage_percentage &lt; 80 else 'bg-warning' if instance.storage_percentage &lt; 90 else 'bg-danger'"/>
                                            <div class="progress-bar"
                                                 t-att-style="'width: ' + str(min(instance.storage_percentage, 100)) + '%'"
                                                 t-att-class="bar_color">
                                                <t t-esc="round(instance.storage_percentage, 1)"/>%
                                            </div>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <p class="text-muted">No storage limit</p>
                                    </t>
                                </div>
                            </div>

                            <!-- Status Badge -->
                            <div class="mt-3">
                                <t t-if="instance.storage_status == 'ok'">
                                    <span class="badge bg-success"><i class="fa fa-check"/> OK</span>
                                </t>
                                <t t-elif="instance.storage_status == 'warning'">
                                    <span class="badge bg-warning"><i class="fa fa-exclamation"/> Warning (80%+)</span>
                                </t>
                                <t t-elif="instance.storage_status == 'critical'">
                                    <span class="badge bg-danger"><i class="fa fa-exclamation-triangle"/> Critical (90%+)</span>
                                </t>
                                <t t-elif="instance.storage_status == 'full'">
                                    <span class="badge bg-dark"><i class="fa fa-times"/> Full (100%+)</span>
                                </t>
                                <t t-elif="instance.storage_status == 'unlimited'">
                                    <span class="badge bg-info"><i class="fa fa-infinity"/> Unlimited</span>
                                </t>
                            </div>

                            <!-- Request Upgrade Button -->
                            <t t-if="not instance.storage_is_unlimited">
                                <div class="mt-3">
                                    <button class="btn btn-primary"
                                            type="button"
                                            data-bs-toggle="modal" data-bs-target="#storageUpgradeModal"
                                            t-att-data-instance-id="instance.id"
                                            t-att-data-instance-name="instance.name"
                                            t-att-data-current-limit="instance.storage_limit_gb">
                                        Request Upgrade
                                    </button>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>

            <t t-call="saas_storage_management.storage_upgrade_widget"/>
        </t>
    </template>

    <!-- Per-instance storage page: current usage + last 7 days report + request upgrade -->
    <template id="portal_storage_instance_detail" name="Instance Storage">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Storage - <t t-esc="instance.name"/></t>
            </t>

            <div class="row mt16">
                <div class="col-12">
                    <div class="card mb-4">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h4 class="mb-0"><i class="fa fa-database text-warning me-2"/><t t-esc="instance.name"/></h4>
                            <t t-if="not instance.storage_is_unlimited">
                                <button class="btn btn-primary"
                                        type="button"
                                        data-bs-toggle="modal" data-bs-target="#storageUpgradeModal"
                                        t-att-data-instance-id="instance.id"
                                        t-att-data-instance-name="instance.name"
                                        t-att-data-current-limit="instance.storage_limit_gb">
                                    Request Upgrade
                                </button>
                            </t>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <t t-if="instance.storage_is_unlimited">
                                        <p><strong>Storage:</strong> <span class="badge bg-info">Unlimited</span></p>
                                        <p><strong>Used:</strong> <t t-esc="round(instance.storage_used_gb, 2)"/> GB</p>
                                    </t>
                                    <t t-else="">
                                        <p><strong>Used:</strong> <t t-esc="round(instance.storage_used_gb, 2)"/> GB / <t t-esc="instance.storage_limit_gb"/> GB</p>
                                        <p><strong>Usage:</strong> <t t-esc="round(instance.storage_percentage, 1)"/>%</p>
                                    </t>
                                    <p class="text-muted small" t-if="instance.storage_last_check">
                                        Last checked: <t t-esc="instance.storage_last_check"/>
                                    </p>
                                </div>
                                <div class="col-md-6">
                                    <t t-if="not instance.storage_is_unlimited">
                                        <div class="progress" style="height: 25px;">
                                            <t t-set="bar_color" t-value="'bg-success' if instance.storage_percentage &lt; 80 else 'bg-warning' if instance.storage_percentage &lt; 90 else 'bg-danger'"/>
                                            <div class="progress-bar"
                                                 t-att-style="'width: ' + str(min(instance.storage_percentage, 100)) + '%'"
                                                 t-att-class="bar_color">
                                                <t t-esc="round(instance.storage_percentage, 1)"/>%
                                            </div>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <p class="text-muted">No storage limit</p>
                                    </t>
                                </div>
                            </div>

                            <div class="mt-3">
                                <t t-if="instance.storage_status == 'ok'">
                                    <span class="badge bg-success"><i class="fa fa-check"/> OK</span>
                                </t>
                                <t t-elif="instance.storage_status == 'warning'">
                                    <span class="badge bg-warning"><i class="fa fa-exclamation"/> Warning (80%+)</span>
                                </t>
                                <t t-elif="instance.storage_status == 'critical'">
                                    <span class="badge bg-danger"><i class="fa fa-exclamation-triangle"/> Critical (90%+)</span>
                                </t>
                                <t t-elif="instance.storage_status == 'full'">
                                    <span class="badge bg-dark"><i class="fa fa-times"/> Full (100%+) - Instance Stopped</span>
                                </t>
                                <t t-elif="instance.storage_status == 'unlimited'">
                                    <span class="badge bg-info"><i class="fa fa-infinity"/> Unlimited</span>
                                </t>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Last 7 Days Usage</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Used (GB)</th>
                                            <th>Limit (GB)</th>
                                            <th>Usage %</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-if="not daily_history">
                                            <td colspan="5" class="text-center text-muted py-4">No history yet for the last 7 days.</td>
                                        </tr>
                                        <t t-foreach="daily_history" t-as="h">
                                            <tr>
                                                <td><t t-esc="h.check_date.strftime('%Y-%m-%d')"/></td>
                                                <td><t t-esc="round(h.storage_used_gb, 2)"/></td>
                                                <td><t t-esc="h.storage_limit_gb"/></td>
                                                <td><t t-esc="round(h.storage_percentage, 1)"/>%</td>
                                                <td>
                                                    <t t-if="h.storage_status == 'ok'">
                                                        <span class="badge bg-success">OK</span>
                                                    </t>
                                                    <t t-elif="h.storage_status == 'warning'">
                                                        <span class="badge bg-warning">Warning</span>
                                                    </t>
                                                    <t t-elif="h.storage_status == 'critical'">
                                                        <span class="badge bg-danger">Critical</span>
                                                    </t>
                                                    <t t-elif="h.storage_status == 'full'">
                                                        <span class="badge bg-dark">Full</span>
                                                    </t>
                                                    <t t-elif="h.storage_status == 'unlimited'">
                                                        <span class="badge bg-info">Unlimited</span>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <t t-call="saas_storage_management.storage_upgrade_widget"/>
        </t>
    </template>

</odoo>
