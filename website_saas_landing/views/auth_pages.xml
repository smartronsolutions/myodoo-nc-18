<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

<record id="saas_auth_pages" model="ir.ui.view">
  <field name="name">website_saas_landing.auth_pages</field>
  <field name="key">website_saas_landing.auth_pages</field>
  <field name="inherit_id" ref="website.layout"/>
  <field name="type">qweb</field>
  <field name="arch" type="xml">
    <xpath expr="//head" position="inside">
<style>
/* My Odoo SaaS auth pages: InvoiceOne-style split screen */
html:has(.oe_website_login_container) body,
html:has(.oe_website_login_container) body.bg-100 {
  background:#fff !important;
}

html:has(.oe_website_login_container) .mo_nav,
html:has(.oe_website_login_container) .mo_mobile_nav,
html:has(.oe_website_login_container) #wrapwrap > header,
html:has(.oe_website_login_container) #wrapwrap > footer,
html:has(.oe_website_login_container) .o_main_navbar,
html:has(.oe_website_login_container) .o_website_header {
  display:none !important;
}

html:has(.oe_website_login_container) #wrapwrap > main {
  padding-top:0 !important;
  margin-top:0 !important;
}

#wrapwrap .oe_website_login_container {
  min-height:100vh;
  padding:0 !important;
  margin:0 !important;
  overflow:hidden !important;
  background:#fff !important;
  font-family:'Inter','Segoe UI',Arial,sans-serif;
  position:relative !important;
}

#wrapwrap .oe_website_login_container::before {
  content:'PRODUCTIVITE &amp; FOCUS\A\A PROJET MY ODOO - SAAS CLOUD';
  position:absolute;
  top:60px;
  left:calc(44vw + 86px);
  z-index:3;
  color:#fff;
  white-space:pre-line;
  font-size:13px;
  line-height:2.9;
  font-weight:900;
  letter-spacing:.7px;
  text-transform:uppercase;
}

#wrapwrap .oe_website_login_container::after {
  content:'SYSTEME CLOUD CERTIFIE ODOO 18';
  position:absolute;
  top:66px;
  right:38px;
  z-index:3;
  color:rgba(255,255,255,.43);
  font-size:12px;
  font-weight:900;
  letter-spacing:.35px;
  text-transform:uppercase;
}

#wrapwrap .oe_website_login_container > .container {
  display:grid !important;
  grid-template-columns:44vw 56vw;
  min-height:100vh;
  width:100% !important;
  max-width:none !important;
  padding:0 !important;
  margin:0 !important;
  position:relative;
}

#wrapwrap .oe_website_login_container > .container::before {
  content:'';
  grid-column:2;
  grid-row:1;
  min-height:100vh;
  background:
    linear-gradient(120deg,rgba(255,255,255,.045) 1px,transparent 1px) 0 0/86px 86px,
    linear-gradient(60deg,transparent 16%,rgba(255,255,255,.035) 16.2%,transparent 16.8%,transparent 44%,rgba(255,255,255,.03) 44.2%,transparent 45%),
    radial-gradient(ellipse 70% 56% at 42% 45%,rgba(47,99,234,.35),transparent 64%),
    radial-gradient(ellipse 45% 70% at 100% 52%,rgba(8,24,65,.55),transparent 70%),
    linear-gradient(104deg,#254FDB 0%,#1D43B8 34%,#19377F 68%,#101F49 100%);
  position:relative;
}

#wrapwrap .oe_website_login_container > .container::after {
  content:'Votre temps est\A precieux, utilisez-le\A pour grandir.';
  grid-column:2;
  grid-row:1;
  align-self:start;
  justify-self:start;
  margin:320px 0 0 86px;
  width:min(620px,70%);
  color:#fff;
  white-space:pre-line;
  font-size:54px;
  line-height:1.12;
  font-weight:400;
  letter-spacing:0;
  position:relative;
  z-index:1;
  text-shadow:0 18px 50px rgba(0,0,0,.22);
}

#wrapwrap .oe_website_login_container .row {
  grid-column:1;
  grid-row:1;
  min-height:100vh;
  margin:0 !important;
  display:flex !important;
  align-items:center !important;
  justify-content:flex-start !important;
  padding:48px 0 48px 18.5% !important;
  position:relative;
}

#wrapwrap .oe_website_login_container .row::before {
  content:'"Avec My Odoo, nous avons arrete de perdre du temps sur les deploiements manuels. Les builds, sauvegardes et domaines sont centralises, et notre equipe peut se concentrer sur les clients."\A\A   Steven Admin\A   RESPONSABLE OPERATIONS, NOUMEA';
  position:absolute;
  left:calc(44vw + 86px);
  bottom:96px;
  z-index:3;
  width:min(880px,48vw);
  color:rgba(255,255,255,.9);
  white-space:pre-line;
  font-size:20px;
  line-height:1.55;
  font-style:italic;
  font-weight:500;
}

#wrapwrap .oe_website_login_container .row::after {
  content:'© 2026 MY ODOO CLOUD\A CONTRAT SAAS-ODOO-18';
  position:absolute;
  left:calc(44vw + 86px);
  right:36px;
  bottom:38px;
  z-index:3;
  padding-top:18px;
  border-top:1px solid rgba(255,255,255,.18);
  color:rgba(255,255,255,.42);
  white-space:pre-line;
  font-size:11px;
  line-height:1;
  font-weight:900;
  display:flex;
}

#wrapwrap .oe_website_login_container .col,
#wrapwrap .oe_website_login_container [class*="col-"] {
  padding:0 !important;
  width:100% !important;
  max-width:420px !important;
  flex:0 0 100% !important;
}

#wrapwrap .oe_website_login_container .o_database_list,
#wrapwrap .oe_website_login_container .card.o_database_list {
  width:100% !important;
  max-width:420px !important;
  margin:0 !important;
  padding:0 !important;
  background:transparent !important;
  border:0 !important;
  border-radius:0 !important;
  box-shadow:none !important;
}

#wrapwrap .oe_website_login_container .card-body {
  padding:0 !important;
  background:transparent !important;
}

#wrapwrap .oe_website_login_container .card-body > .text-center.pb-3 {
  text-align:left !important;
  padding:0 0 20px !important;
  margin:0 0 4px !important;
  border:0 !important;
}

#wrapwrap .oe_website_login_container .card-body > .text-center.pb-3::before {
  content:'mO';
  display:inline-flex;
  width:48px;
  height:48px;
  align-items:center;
  justify-content:center;
  margin-right:12px;
  border-radius:9px;
  background:#2F63EA;
  color:#fff;
  font-weight:900;
  font-size:18px;
  vertical-align:middle;
  box-shadow:0 12px 28px rgba(47,99,234,.28);
}

#wrapwrap .oe_website_login_container .card-body > .text-center.pb-3::after {
  content:'My Odoo\A @ SAAS CLOUD';
  display:inline-block;
  color:#111827;
  white-space:pre-line;
  font-size:22px;
  line-height:1.04;
  font-weight:800;
  vertical-align:middle;
}

#wrapwrap .oe_website_login_container .card-body > .text-center.pb-3 img {
  display:none !important;
}

#wrapwrap .oe_website_login_container .oe_login_form::before,
#wrapwrap .oe_website_login_container .oe_signup_form::before,
#wrapwrap .oe_website_login_container .oe_reset_password_form::before {
  display:block;
  margin:0 0 4px;
  color:#0F172A;
  font-size:29px;
  line-height:1.16;
  font-weight:850;
  letter-spacing:0;
}

#wrapwrap .oe_website_login_container .oe_login_form::before {
  content:'Bienvenue de retour.';
}
#wrapwrap .oe_website_login_container .oe_signup_form::before {
  content:'Creez votre compte.';
}
#wrapwrap .oe_website_login_container .oe_reset_password_form::before {
  content:'Mot de passe oublie.';
}

#wrapwrap .oe_website_login_container .oe_login_form::after,
#wrapwrap .oe_website_login_container .oe_signup_form::after,
#wrapwrap .oe_website_login_container .oe_reset_password_form::after {
  display:block;
  margin:0 0 24px;
  color:#667085;
  font-size:14px;
  line-height:1.6;
}

#wrapwrap .oe_website_login_container .oe_login_form::after {
  content:'Connectez-vous pour gerer votre plateforme Odoo SaaS avec focus.';
}
#wrapwrap .oe_website_login_container .oe_signup_form::after {
  content:'Lancez votre espace My Odoo et deployez votre premier projet en quelques minutes.';
}
#wrapwrap .oe_website_login_container .oe_reset_password_form::after {
  content:'Entrez votre e-mail, nous vous enverrons un lien securise de reinitialisation.';
}

#wrapwrap .oe_website_login_container label {
  color:#6B7280 !important;
  font-size:11px !important;
  font-weight:800 !important;
  letter-spacing:.45px !important;
  text-transform:uppercase !important;
  margin-bottom:7px !important;
}

#wrapwrap .oe_website_login_container .form-control {
  min-height:39px !important;
  height:39px !important;
  color:#111827 !important;
  background:#fff !important;
  border:1px solid #D0D5DD !important;
  border-radius:7px !important;
  padding:9px 13px !important;
  font-size:14px !important;
  box-shadow:0 1px 2px rgba(16,24,40,.04) !important;
  transition:border-color .18s,box-shadow .18s !important;
}

#wrapwrap .oe_website_login_container .form-control::placeholder {
  color:#98A2B3 !important;
}

#wrapwrap .oe_website_login_container .form-control:focus {
  border-color:#2F63EA !important;
  box-shadow:0 0 0 3px rgba(47,99,234,.14) !important;
  outline:none !important;
}

#wrapwrap .oe_website_login_container .input-group .btn,
#wrapwrap .oe_website_login_container .o_show_password {
  min-height:39px !important;
  height:39px !important;
  color:#667085 !important;
  background:#F2F4F7 !important;
  border-color:#D0D5DD !important;
  border-radius:0 7px 7px 0 !important;
}

#wrapwrap .oe_website_login_container .btn-primary {
  width:100% !important;
  min-height:41px !important;
  border:0 !important;
  border-radius:7px !important;
  margin-top:28px !important;
  color:#fff !important;
  background:#2F63EA !important;
  font-size:14px !important;
  font-weight:850 !important;
  box-shadow:0 10px 22px rgba(47,99,234,.28) !important;
  transition:transform .18s,box-shadow .18s,background .18s !important;
}

#wrapwrap .oe_website_login_container .btn-primary:hover {
  transform:translateY(-1px) !important;
  background:#2554D8 !important;
  box-shadow:0 14px 28px rgba(47,99,234,.34) !important;
}

#wrapwrap .oe_website_login_container .btn-secondary,
#wrapwrap .oe_website_login_container .btn-outline-secondary {
  min-height:40px !important;
  border-radius:7px !important;
  color:#344054 !important;
  background:#F9FAFB !important;
  border:1px solid #D0D5DD !important;
  font-weight:700 !important;
}

#wrapwrap .oe_website_login_container a,
#wrapwrap .oe_website_login_container .btn-link {
  color:#2F63EA !important;
  font-weight:800 !important;
  text-decoration:none !important;
}

#wrapwrap .oe_website_login_container a:hover,
#wrapwrap .oe_website_login_container .btn-link:hover {
  color:#1D4ED8 !important;
}

#wrapwrap .oe_website_login_container .alert {
  border-radius:8px !important;
  padding:11px 13px !important;
  font-size:13px !important;
  line-height:1.5 !important;
}

#wrapwrap .oe_website_login_container .alert-danger {
  color:#B42318 !important;
  background:#FEF3F2 !important;
  border:1px solid #FECDCA !important;
}

#wrapwrap .oe_website_login_container .alert-success,
#wrapwrap .oe_website_login_container .alert-info {
  color:#175CD3 !important;
  background:#EFF8FF !important;
  border:1px solid #B2DDFF !important;
}

#wrapwrap .oe_website_login_container .card-body > .text-center.small {
  margin-top:220px !important;
  padding-top:16px !important;
  border-top:1px solid #EAECF0 !important;
  color:#667085 !important;
  font-size:13px !important;
}

#wrapwrap .oe_website_login_container .o_database_list::after,
#wrapwrap .oe_website_login_container .card.o_database_list::after {
  content:'v18.0                         MY ODOO SAAS                         NIF: 000000000';
  display:block;
  margin-top:20px;
  padding-top:12px;
  border-top:1px solid #EAECF0;
  color:#98A2B3;
  font-size:11px;
  font-weight:900;
  white-space:pre;
}

#wrapwrap .oe_website_login_container .o_login_auth em {
  color:#98A2B3 !important;
}

#wrapwrap .oe_website_login_container .o_login_auth .list-group-item {
  color:#344054 !important;
  background:#F9FAFB !important;
  border-color:#EAECF0 !important;
  border-radius:8px !important;
}

@media(max-width:980px) {
  #wrapwrap .oe_website_login_container {
    min-height:100vh;
    background:linear-gradient(180deg,#fff 0%,#F8FAFC 100%) !important;
  }
  #wrapwrap .oe_website_login_container > .container {
    display:block !important;
    min-height:100vh;
  }
  #wrapwrap .oe_website_login_container > .container::before,
  #wrapwrap .oe_website_login_container > .container::after,
  #wrapwrap .oe_website_login_container::before,
  #wrapwrap .oe_website_login_container::after,
  #wrapwrap .oe_website_login_container .row::before,
  #wrapwrap .oe_website_login_container .row::after {
    display:none !important;
  }
  #wrapwrap .oe_website_login_container .row {
    min-height:100vh;
    padding:36px 22px !important;
    justify-content:center !important;
  }
  #wrapwrap .oe_website_login_container .col,
  #wrapwrap .oe_website_login_container [class*="col-"] {
    max-width:440px !important;
  }
  #wrapwrap .oe_website_login_container .card-body > .text-center.small {
    margin-top:32px !important;
  }
}

@media(max-width:520px) {
  #wrapwrap .oe_website_login_container .row {
    align-items:flex-start !important;
    padding:34px 18px !important;
  }
  #wrapwrap .oe_website_login_container .card-body > .text-center.pb-3::after {
    font-size:20px;
  }
  #wrapwrap .oe_website_login_container .oe_login_form::before,
  #wrapwrap .oe_website_login_container .oe_signup_form::before,
  #wrapwrap .oe_website_login_container .oe_reset_password_form::before {
    font-size:25px !important;
  }
}
</style>
    </xpath>
  </field>
</record>

</data>
</odoo>
