#wrapwrap .oe_website_login_container .form-check-input {
  border-color:#b8c0cc !important;
  border-radius:5px !important;
}

#wrapwrap .oe_website_login_container .form-check-input:checked {
  background-color:var(--mo-auth-blue) !important;
  border-color:var(--mo-auth-blue) !important;
}

#wrapwrap .oe_website_login_container .mo-auth-terms {
  display:flex;
  gap:10px;
  align-items:flex-start;
  margin-top:2px !important;
}

#wrapwrap .oe_website_login_container .mo-auth-terms .form-check-input {
  width:18px;
  height:18px;
  margin:.1rem 0 0 !important;
  flex:0 0 auto;
}

#wrapwrap .oe_website_login_container .mo-auth-terms .form-check-label {
  margin:0 !important;
  color:#475467 !important;
  font-size:13px !important;
  line-height:1.45;
  font-weight:650 !important;
  letter-spacing:0 !important;
  text-transform:none !important;
}

#wrapwrap .oe_website_login_container .btn-primary {
  width:100% !important;
  min-height:50px !important;
  margin-top:12px !important;
  color:#fff !important;
  background:linear-gradient(135deg,var(--mo-auth-blue),#1d4ed8) !important;
  border:0 !important;
  border-radius:14px !important;
  font-size:15px !important;
  font-weight:850 !important;
  box-shadow:0 16px 32px rgba(37,99,235,.24) !important;
  transition:transform .18s ease,box-shadow .18s ease,filter .18s ease !important;
}

#wrapwrap .oe_website_login_container .btn-primary:hover {
  transform:translateY(-1px);
  filter:saturate(1.06);
  box-shadow:0 20px 38px rgba(37,99,235,.32) !important;
}

#wrapwrap .oe_website_login_container .btn-primary:disabled,
#wrapwrap .oe_website_login_container .btn-primary.mo-auth-loading {
  opacity:.82;
  cursor:wait;
}

#wrapwrap .oe_website_login_container .btn-secondary,
#wrapwrap .oe_website_login_container .btn-outline-secondary {
  min-height:46px !important;
  border-radius:14px !important;
  color:#344054 !important;
  background:#fff !important;
  border:1px solid var(--mo-auth-line) !important;
  font-weight:780 !important;
}

#wrapwrap .oe_website_login_container a,
#wrapwrap .oe_website_login_container .btn-link {
  color:var(--mo-auth-blue) !important;
  font-weight:780 !important;
  text-decoration:none !important;
}

#wrapwrap .oe_website_login_container a:hover,
#wrapwrap .oe_website_login_container .btn-link:hover {
  color:#1d4ed8 !important;
}

#wrapwrap .oe_website_login_container .alert {
  border-radius:14px !important;
  padding:12px 14px !important;
  border:1px solid transparent !important;
  font-size:14px !important;
  line-height:1.48 !important;
}

#wrapwrap .oe_website_login_container .alert-danger {
  color:#b42318 !important;
  background:#fef3f2 !important;
  border-color:#fecdca !important;
}

#wrapwrap .oe_website_login_container .alert-success {
  color:#027a48 !important;
  background:#ecfdf3 !important;
  border-color:#abefc6 !important;
}

#wrapwrap .oe_website_login_container .alert-info,
#wrapwrap .oe_website_login_container .alert-warning {
  color:#175cd3 !important;
  background:#eff8ff !important;
  border-color:#b2ddff !important;
}

#wrapwrap .oe_website_login_container .mo-auth-strength {
  display:none;
  margin:-5px 0 14px;
}

#wrapwrap .oe_website_login_container .mo-auth-strength.is-visible {
  display:block;
}

#wrapwrap .oe_website_login_container .mo-auth-strength-track {
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:5px;
  height:5px;
  margin-bottom:7px;
}

#wrapwrap .oe_website_login_container .mo-auth-strength-track span {
  border-radius:999px;
  background:#eaecf0;
}

#wrapwrap .oe_website_login_container .mo-auth-strength[data-score="1"] span:nth-child(-n+1) { background:#f04438; }
#wrapwrap .oe_website_login_container .mo-auth-strength[data-score="2"] span:nth-child(-n+2) { background:#f79009; }
#wrapwrap .oe_website_login_container .mo-auth-strength[data-score="3"] span:nth-child(-n+3) { background:#12b76a; }
#wrapwrap .oe_website_login_container .mo-auth-strength[data-score="4"] span:nth-child(-n+4) { background:#039855; }

#wrapwrap .oe_website_login_container .mo-auth-strength-text {
  color:#667085;
  font-size:12px;
  font-weight:700;
}

#wrapwrap .oe_website_login_container .card-body > .text-center.small,
#wrapwrap .oe_website_login_container .o_login_auth {
  margin-top:24px !important;
  color:#667085 !important;
  font-size:13px !important;
}

#wrapwrap .oe_website_login_container .card-body > .text-center.small {
  padding-top:18px !important;
  border-top:1px solid #eaecf0 !important;
}

#wrapwrap .oe_website_login_container .o_database_list::after,
#wrapwrap .oe_website_login_container .card.o_database_list::after {
  content:"Protected by CSRF validation  |  Email verification ready";
  display:block;
  margin-top:20px;
  color:#98a2b3;
  font-size:12px;
  font-weight:750;
  text-align:center;
}

@keyframes moAuthFormIn {
  from { opacity:0; transform:translateX(-16px); }
  to { opacity:1; transform:translateX(0); }
}

@keyframes moAuthPanelIn {
  from { opacity:0; transform:translateY(18px); }
  to { opacity:1; transform:translateY(0); }
}

@media (max-width:1100px) {
  #wrapwrap .oe_website_login_container > .container {
    grid-template-columns:minmax(390px,48vw) minmax(0,1fr);
  }
  #wrapwrap .oe_website_login_container .row::before,
  #wrapwrap .oe_website_login_container .row::after {
    left:calc(48vw + 42px);
  }
}

@media (max-width:920px) {
  #wrapwrap .oe_website_login_container {
    background:
      linear-gradient(180deg,rgba(11,31,67,.8),rgba(11,31,67,.9)),
      linear-gradient(145deg,#1643c7 0%,#12378f 44%,#0b1f43 100%) !important;
    overflow:auto;
  }
  #wrapwrap .oe_website_login_container > .container {
    display:block !important;
    min-height:100vh;
    padding:28px 20px !important;
  }
  #wrapwrap .oe_website_login_container > .container::before,
  #wrapwrap .oe_website_login_container > .container::after,
  #wrapwrap .oe_website_login_container .row::before,
  #wrapwrap .oe_website_login_container .row::after {
    display:none !important;
  }
  #wrapwrap .oe_website_login_container .row {
    min-height:auto;
    max-width:540px;
    margin:0 auto !important;
    padding:34px 26px !important;
    border-radius:26px;
    background:#fff;
    box-shadow:0 28px 80px rgba(2,6,23,.28);
  }
  #wrapwrap .oe_website_login_container .col,
  #wrapwrap .oe_website_login_container [class*="col-"] {
