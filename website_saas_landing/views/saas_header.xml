</div>

<!-- ══════════════ NAV JS ══════════════ -->
<script>
(function(){
  var nav       = document.getElementById('mo_nav');
  var hamburger = document.getElementById('mo_hamburger');
  var mobileNav = document.getElementById('mo_mobile_nav');
  var accBtn    = document.getElementById('mo_account_btn');
  var accDrop   = document.getElementById('mo_account_drop');
  var accWrap   = document.getElementById('mo_account');

  /* Scroll shadow */
  if(nav){
    window.addEventListener('scroll', function(){ nav.classList.toggle('scrolled', window.scrollY > 30); }, {passive:true});
  }

  /* Hamburger toggle */
  if(hamburger &amp;&amp; mobileNav){
    hamburger.addEventListener('click', function(){
      hamburger.classList.toggle('mo_open');
      mobileNav.classList.toggle('mo_open');
      document.body.style.overflow = mobileNav.classList.contains('mo_open') ? 'hidden' : '';
    });
    mobileNav.querySelectorAll('a').forEach(function(a){
      a.addEventListener('click', function(){
        hamburger.classList.remove('mo_open');
        mobileNav.classList.remove('mo_open');
        document.body.style.overflow = '';
      });
    });
  }

  /* Account dropdown */
  if(accBtn &amp;&amp; accDrop){
    accBtn.addEventListener('click', function(e){
      e.stopPropagation();
      accBtn.classList.toggle('mo_active_btn');
      accDrop.classList.toggle('mo_open');
    });
    document.addEventListener('click', function(e){
      if(accWrap &amp;&amp; !accWrap.contains(e.target)){
        accBtn.classList.remove('mo_active_btn');
        accDrop.classList.remove('mo_open');
      }
    });
  }

  /* Active link highlight */
  var path = window.location.pathname;
  document.querySelectorAll('.mo_nav_ul a').forEach(function(a){
    if(a.getAttribute('href') === path){ a.classList.add('mo_active'); }
  });
})();
</script>

    </xpath>

    <!-- Hide Odoo's native header on all pages -->
    <xpath expr="//header" position="attributes">
      <attribute name="style">display:none!important</attribute>
    </xpath>

  </field>
</record>

</data>
</odoo>

