<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

<!-- Global Header — injects on EVERY website page except the /saas landing page -->
<record id="saas_global_header" model="ir.ui.view">
  <field name="name">website_saas_landing.global_header</field>
  <field name="key">website_saas_landing.global_header</field>
  <field name="inherit_id" ref="website.layout"/>
  <field name="type">qweb</field>
  <field name="arch" type="xml">

    <xpath expr="//header" position="before">

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;family=Bricolage+Grotesque:wght@400;500;600;700;800&amp;display=swap');

/* Hide Odoo default header &amp; footer sitewide */
#wrapwrap > header,
#wrapwrap > footer,
.o_main_navbar { display:none !important; }

/* Push all page content below our 72px fixed navbar */
#wrapwrap > main { padding-top:72px !important; margin-top:0 !important; }

/* Landing page (.oc_page) manages its own layout — cancel the push */
body:has(.oc_page) #wrapwrap > main { padding-top:0 !important; margin-top:0 !important; }

body { overflow-x:hidden; }

/* ── NAV ── */
.mo_nav {
  position:fixed;top:0;left:0;right:0;z-index:9999;
  padding:0 5%;height:72px;
  display:flex;align-items:center;justify-content:space-between;gap:16px;
  background:rgba(255,255,255,.96);
  backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  border-bottom:1px solid #E2E8F0;
  transition:box-shadow .3s;
  font-family:'Inter',system-ui,sans-serif;
}
.mo_nav.scrolled { box-shadow:0 4px 24px rgba(124,58,237,.08); }

/* Logo */
.mo_logo {
  text-decoration:none !important;white-space:nowrap;flex-shrink:0;
  display:flex;align-items:center;
}

/* Nav links */
.mo_nav_ul {
  display:flex;gap:24px;list-style:none;align-items:center;flex:1;justify-content:center;
  padding:0;margin:0;
}
.mo_nav_ul a {
  color:#64748B !important;text-decoration:none !important;
  font-size:.875rem;font-weight:500;transition:color .2s;white-space:nowrap;
}
.mo_nav_ul a:hover, .mo_nav_ul a.mo_active { color:#7C3AED !important; }

.mo_nav_right { display:flex;align-items:center;gap:8px;flex-shrink:0; }

/* Se connecter ghost */
.mo_btn_ghost {
  color:#0F172A !important;background:transparent;
  border:1.5px solid #E2E8F0;padding:8px 18px;border-radius:8px;
  font-size:.85rem;font-weight:500;text-decoration:none !important;white-space:nowrap;
  transition:all .2s;display:inline-block;
}
.mo_btn_ghost:hover { border-color:#7C3AED;color:#7C3AED !important;background:#EDE9FE; }

/* Get Demo CTA */
.mo_btn_cta {
  background:#7C3AED;color:#fff !important;padding:9px 20px;border-radius:8px;
  font-size:.85rem;font-weight:600;text-decoration:none !important;white-space:nowrap;
  transition:all .2s;display:inline-flex;align-items:center;gap:6px;
  box-shadow:0 2px 8px rgba(124,58,237,.25);border:none;
}
.mo_btn_cta:hover { background:#5B21B6;transform:translateY(-1px);box-shadow:0 4px 16px rgba(124,58,237,.35);color:#fff !important; }

/* ── ACCOUNT DROPDOWN ── */
.mo_account { position:relative; }
.mo_account_btn {
  display:flex;align-items:center;gap:6px;
  background:transparent;border:1.5px solid #E2E8F0;
  color:#0F172A;padding:8px 12px;border-radius:8px;
  font-size:.85rem;font-weight:500;cursor:pointer;transition:all .2s;
  font-family:'Inter',sans-serif;white-space:nowrap;
}
.mo_account_btn:hover, .mo_account_btn.mo_active_btn {
  border-color:#7C3AED;color:#7C3AED;background:#EDE9FE;
}
.mo_account_drop {
  position:absolute;top:calc(100% + 10px);right:0;min-width:240px;
  background:#fff;border:1px solid #E2E8F0;border-radius:14px;
  padding:8px;box-shadow:0 16px 48px rgba(0,0,0,.12);
  opacity:0;visibility:hidden;transform:translateY(-8px);
  transition:opacity .2s,visibility .2s,transform .2s;z-index:9998;
}
.mo_account_drop.mo_open { opacity:1;visibility:visible;transform:translateY(0); }
.mo_account_drop a {
  display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:9px;
  font-size:.85rem;color:#0F172A !important;text-decoration:none !important;
  transition:all .15s;white-space:nowrap;font-family:'Inter',sans-serif;
}
.mo_account_drop a:hover { background:#EDE9FE;color:#7C3AED !important; }
.mo_drop_sep { height:1px;background:#E2E8F0;margin:6px 2px; }
.mo_account_drop a svg { flex-shrink:0;opacity:.5; }
.mo_account_drop a:hover svg { opacity:1; }

/* ── HAMBURGER ── */
.mo_hamburger {
  display:none;flex-direction:column;justify-content:center;align-items:center;gap:5px;
  background:transparent;border:1.5px solid #E2E8F0;
  padding:9px 10px;border-radius:8px;cursor:pointer;min-width:42px;height:40px;
  transition:border-color .2s;
}
.mo_hamburger:hover { border-color:#7C3AED; }
.mo_hamburger span {
  display:block;width:20px;height:2px;background:#0F172A;
  border-radius:2px;transition:all .3s;
}
.mo_hamburger.mo_open span:nth-child(1) { transform:translateY(7px) rotate(45deg); }
.mo_hamburger.mo_open span:nth-child(2) { opacity:0;transform:scaleX(0); }
.mo_hamburger.mo_open span:nth-child(3) { transform:translateY(-7px) rotate(-45deg); }

/* ── MOBILE NAV ── */
.mo_mobile_nav {
  position:fixed;top:72px;left:0;right:0;bottom:0;z-index:9997;
  background:#fff;border-top:1px solid #E2E8F0;
  padding:24px 6% 60px;overflow-y:auto;
  transform:translateX(-100%);transition:transform .35s cubic-bezier(.4,0,.2,1);
}
.mo_mobile_nav.mo_open { transform:translateX(0); }
.mo_mobile_nav ul { list-style:none;padding:0;margin:0; }
.mo_mobile_nav ul li a {
  display:block;padding:15px 0;font-size:1rem;font-weight:500;
  color:#0F172A !important;text-decoration:none !important;
  border-bottom:1px solid #E2E8F0;transition:color .2s;
  font-family:'Inter',sans-serif;
}
.mo_mobile_nav ul li a:hover { color:#7C3AED !important; }
.mo_mobile_nav ul li:last-child a { border-bottom:none; }
.mo_mobile_sep { height:1px;background:#E2E8F0;margin:20px 0; }
.mo_mobile_label {
  display:block;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;
  color:#94A3B8;padding:16px 0 6px;font-family:'Inter',sans-serif;
}
.mo_mobile_cta {
  display:block;background:#7C3AED;color:#fff !important;
  text-align:center;padding:14px 20px;border-radius:10px;
  font-size:.95rem;font-weight:700;margin:16px 0 10px;text-decoration:none !important;
  transition:all .2s;box-shadow:0 4px 20px rgba(124,58,237,.3);
}
.mo_mobile_cta:hover { background:#5B21B6;color:#fff !important; }
.mo_mobile_ghost {
  display:block;background:transparent;color:#0F172A !important;
  text-align:center;padding:13px 20px;border-radius:10px;
  font-size:.95rem;font-weight:600;border:1.5px solid #E2E8F0;
  text-decoration:none !important;transition:all .2s;
}
.mo_mobile_ghost:hover { border-color:#7C3AED;color:#7C3AED !important; }

/* ── RESPONSIVE ── */
@media(max-width:1100px){
  .mo_nav { padding:0 3%; }
  .mo_nav_ul { gap:16px; }
  .mo_nav_ul a { font-size:.82rem; }
}
@media(max-width:960px){
  .mo_nav_ul { display:none !important; }
  .mo_btn_ghost { display:none !important; }
  .mo_hamburger { display:flex !important; }
}
@media(max-width:640px){
  .mo_btn_cta { display:none !important; }
  .mo_nav { padding:0 5%; }
}
</style>

<!-- ══════════════ NAVBAR ══════════════ -->
<nav class="mo_nav" id="mo_nav">
  <a href="/" class="mo_logo">
    <img src="/website_saas_landing/static/description/icon.png" alt="My Odoo" style="height:38px;width:auto;display:block;"/>
  </a>

  <ul class="mo_nav_ul">
    <li><a href="/">Accueil</a></li>
    <li><a href="/shop">Boutique</a></li>
    <li><a href="https://myodoo.nc/pricing">Tarifs</a></li>
    <li><a href="/saas#oc_features">Services</a></li>
    <li><a href="/saas#oc_testi">Témoignages De Réussite</a></li>
    <li><a href="/about">À propos de nous</a></li>
    <li><a href="/contactus">Contactez-nous</a></li>
  </ul>

  <div class="mo_nav_right">
    <a href="https://myodoo.nc/pricing" class="mo_btn_cta">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polygon points="10,8 16,12 10,16"/></svg>
      Get Demo
    </a>

    <!-- Account Dropdown -->
    <div class="mo_account" id="mo_account">
      <button class="mo_account_btn" id="mo_account_btn" type="button">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <t t-if="request.env.user._is_public()">Sign in</t>
        <t t-if="not request.env.user._is_public()">My Account</t>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="mo_account_drop" id="mo_account_drop">

        <t t-if="not request.env.user._is_public()">
          <a href="/my">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            Mon Compte
          </a>
          <div class="mo_drop_sep"/>
          <a href="/web/session/logout">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Déconnexion
          </a>
        </t>

        <t t-if="request.env.user._is_public()">
          <a href="/web/login">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            Connexion
          </a>
          <a href="/web/signup">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
            Créer un compte
          </a>
          <a href="/web/reset_password">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 12a9 9 0 1 1 3 6.7"/><path d="M3 21v-6h6"/></svg>
            Mot de passe oublié
          </a>
        </t>
        <div class="mo_drop_sep"/>
        <a href="https://myodoo.nc/pricing">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polygon points="10,8 16,12 10,16"/></svg>
          Get Demo
        </a>

      </div>
    </div>

    <!-- Hamburger -->
    <button class="mo_hamburger" id="mo_hamburger" type="button" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<!-- ══════════════ MOBILE NAV ══════════════ -->
<div class="mo_mobile_nav" id="mo_mobile_nav">
  <ul>
    <li><a href="/">Accueil</a></li>
    <li><a href="/shop">Boutique</a></li>
